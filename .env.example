# Public Testnet identity. / Identidade pública da Testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_ISSUER=

# Server-only administrative secret; do not commit a real value.
# Segredo administrativo apenas do servidor; não versione um valor real.
STELLAR_ISSUER_SECRET=

# Distribution wallet used only for fixed Testnet demo balances.
# Carteira de distribuição usada somente para saldos fixos de demonstração Testnet.
STELLAR_DISTRIBUTION_SECRET=

# Explicitly enable only in a disposable Testnet environment.
# Habilite explicitamente apenas em ambiente descartável de Testnet.
DEMO_MODE=disabled
